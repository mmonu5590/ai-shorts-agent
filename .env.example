# Storage backend: "local" (default) or "google-drive"
STORAGE_DRIVER=local

# --- local driver ---
LOCAL_STORAGE_DIR=.data/storage

# --- google-drive driver ---
# Folder that becomes the storage root. Take the ID from the folder URL:
# https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_ROOT_FOLDER_ID=

# ID of the Shared Drive containing DRIVE_ROOT_FOLDER_ID.
# Required with service-account auth: a service account has no Drive storage
# quota, so uploads into a personal My Drive fail with storageQuotaExceeded.
DRIVE_SHARED_DRIVE_ID=

# Service-account credentials as inline JSON. Leave unset to fall back to
# Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_SERVICE_ACCOUNT_KEY=

# Let signedUrl() grant "anyone with the link" read access. Off by default:
# Drive links cannot be time-limited, so the grant is permanent until revoked.
DRIVE_ALLOW_PUBLIC_LINKS=false

# Escape hatch for the Shared Drive check above. Only useful with OAuth user
# credentials, which do have a storage quota.
DRIVE_ALLOW_MY_DRIVE=false
