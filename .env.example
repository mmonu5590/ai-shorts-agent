# Storage backend: "local" (default) or "google-drive"
STORAGE_DRIVER=local

# --- local driver ---
LOCAL_STORAGE_DIR=.data/storage

# --- google-drive driver ---
# Folder that becomes the storage root. Take the ID from the folder URL:
# https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_ROOT_FOLDER_ID=

# ID of the Shared Drive containing DRIVE_ROOT_FOLDER_ID.
# Required with service-account auth: a service account has no Drive storage
# quota, so uploads into a personal My Drive fail with storageQuotaExceeded.
DRIVE_SHARED_DRIVE_ID=

# Service-account credentials as inline JSON. Leave unset to fall back to
# Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS).
GOOGLE_SERVICE_ACCOUNT_KEY=

# Let signedUrl() grant "anyone with the link" read access. Off by default:
# Drive links cannot be time-limited, so the grant is permanent until revoked.
DRIVE_ALLOW_PUBLIC_LINKS=false

# Escape hatch for the Shared Drive check above. Only useful with OAuth user
# credentials, which do have a storage quota.
DRIVE_ALLOW_MY_DRIVE=false

# --- server ---
PORT=3000
# Reject uploads longer than this many seconds. Unset means no limit.
MAX_VIDEO_SECONDS=

# --- transcription ---
# "stub" measures the audio and emits placeholder segments so the pipeline runs
# end to end without a provider (the default). "deepgram" is the real one and
# needs a key below.
TRANSCRIBER=stub

# Read when TRANSCRIBER=deepgram.
DEEPGRAM_API_KEY=
# Deepgram model. Defaults to nova-3.
DEEPGRAM_MODEL=

# --- clip selection ---
# "heuristic" spreads clips evenly and needs no credentials (the default).
# "claude" uses the Anthropic API and needs a credential below.
CLIP_SELECTOR=heuristic

# Read by the Anthropic SDK when CLIP_SELECTOR=claude. Leaving it unset is
# fine if you have run `ant auth login`.
ANTHROPIC_API_KEY=

# --- captions ---
# Burn the transcript into the rendered Shorts.
#   auto (default) - on, unless the transcript came from the stub transcriber
#   on             - always
#   off            - never
CAPTIONS=auto

# --- framing ---
# Choose the 9:16 crop window from where the picture moves, instead of the
# edit plan's centerX. Off by default: motion indicates the subject but does
# not prove it, and a still speaker can lose to a busy background.
AUTO_FRAME=false

# Pipeline runs allowed at once. Rendering is CPU-bound, so more than one
# concurrent run usually makes every run slower rather than faster.
RENDER_CONCURRENCY=1

# --- authentication ---
# Address to bind. Loopback by default so an unauthenticated prototype is not
# reachable from the network just because nothing was configured.
HOST=127.0.0.1

# none  - every caller is "anonymous". Refused on a non-loopback HOST.
# token - Authorization: Bearer <token>, matched against API_TOKENS.
AUTH=none

# principal:token pairs. Tokens must be at least 16 characters.
API_TOKENS=
